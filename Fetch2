function getContactDetails(contactId, callback) {

    var empty = {
        contactName: "-",
        accountName: "-",
        firstname: "-",
        lastname: "-",
        email: "-",
        phone: "-",
        personaLabel: "-"
    };

    if (!contactId) {
        callback(empty);
        return;
    }

    $.ajax({
        url: "/_api/contacts(" + contactId + ")" +
             "?$select=fullname,firstname,lastname,emailaddress1,address1_telephone1,cat_persona,_parentcustomerid_value",
        method: "GET",
        headers: {
            "Accept": "application/json",
            "Prefer": "odata.include-annotations=*"
        },
        success: function (contact) {
            // Company of the Requested From contact (only if it is an Account)
            var parentType = contact["_parentcustomerid_value@Microsoft.Dynamics.CRM.lookuplogicalname"];
            var parentName = contact["_parentcustomerid_value@OData.Community.Display.V1.FormattedValue"];

            callback({
                contactName: contact.fullname ||
                             ((contact.firstname || "") + " " + (contact.lastname || "")).trim() || "-",
                accountName: (parentType === "account" && parentName) ? parentName : "-",
                firstname: contact.firstname || "-",
                lastname: contact.lastname || "-",
                email: contact.emailaddress1 || "-",
                phone: contact.address1_telephone1 || "-",
                personaLabel: contact["cat_persona@OData.Community.Display.V1.FormattedValue"] || "-"
            });
        },
        error: function () {
            callback(empty);
        }
    });
}


