  border-top: 1px solid #ddd;
  border-bottom: none;
  text-align: right;
}
 
.tile-settings-body {
  padding: 16px;
  flex-grow: 1;
}
 
.close-btn {
  cursor: pointer;
  font-size: 22px;
}

</style>


