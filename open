<div id="iwjt7g" class="row sectionBlockLayout text-start" style="display: flex; flex-wrap: wrap; margin: 0px; min-height: auto; padding: 8px;">
  <div id="i7mtpj" class="container" style="padding: 0px; display: flex; flex-wrap: wrap; max-width: 100%;">
    <div class="col-lg-12 columnBlockLayout" style="flex-grow: 1; display: flex; flex-direction: column; min-width: 250px; margin-top: 0;">
      <h2 class="mpc-header">My Open Cases</h2>
      <div id="dealerCasesContainer">
        {% if user.roles contains "Cat_Dealer Persona Role" or user.roles contains "Cat_Internal Customer Persona Role" or user.roles contains "Cat_Customer Persona Role" %} {% fetchxml allStatusOptions %}
        <fetch version="1.0" mapping="logical" distinct="true">
          <entity name="incident">
            <attribute name="cat_helpcenterstatus"></attribute>

            <filter type="and">
              <condition attribute="cat_helpcenterstatus" operator="not-null"></condition>
            </filter>

            <order attribute="cat_helpcenterstatus" descending="false"></order>
          </entity>
        </fetch>
        {% endfetchxml %} {% fetchxml allDealerCodeOptions %}
        <fetch version="1.0" mapping="logical" distinct="true">
          <entity name="incident">
            <attribute name="cat_dealercode"></attribute>

            <filter type="and">
              <condition attribute="cat_dealercode" operator="not-null"></condition>
            </filter>

            <order attribute="cat_dealercode" descending="false"></order>
          </entity>
        </fetch>
        {% endfetchxml %} {% assign productPersonaValue = "" %} {% if user.roles contains "Cat_Dealer Persona Role" %} {% assign productPersonaValue = "100000001" %} {% elsif user.roles contains "Cat_Internal Customer Persona Role" %} {% assign productPersonaValue = "100000003" %} {% elsif user.roles contains "Cat_Customer Persona Role" %} {% assign productPersonaValue = "100000000" %} {% endif %} {% fetchxml allProductOptions %}
        <fetch version="1.0" mapping="logical" distinct="true">
          <entity name="product">
            <attribute name="productid"></attribute>
            <attribute name="name"></attribute>
            <filter type="and">
              <condition attribute="producttypecode" operator="eq" value="1" />
              <condition attribute="statecode" operator="eq" value="0" />
              <condition attribute="cat_persona" operator="contain-values">
                <value>{{ productPersonaValue }}</value>
              </condition>
            </filter>
            <order attribute="name" descending="false"></order>
          </entity>
        </fetch>
        {% endfetchxml %} {% fetchxml myCase %}
        <fetch version="1.0" mapping="logical" distinc="true">
          <entity name="incident">
            <attribute name="ticketnumber" />
            <attribute name="cat_dealercode" />

            <!-- 7. Date Opened -->
            <attribute name="createdon" />
            <attribute name="productid" />
            <!-- 10. Product Technology-->
            <link-entity name="product" from="productid" to="productid" alias="product" link-type="outer">
              <attribute name="name" alias="producttechnology" />
            </link-entity>
            <attribute name="cat_helpcenterstatus" />
            <!-- 11. Subject -->
            <attribute name="title" />
            <!-- 12.Description -->
            <attribute name="description" />
            <filter type="and">
              <condition attribute="cat_helpcenterstatus" operator="in">
                <value>100000000</value>
                <value>100000001</value>
                <value>100000002</value>
                <value>100000003</value>
                <value>100000004</value>
                <value>100000005</value>
              </condition>
              <condition attribute="parentcaseid" operator="null" />
              <condition attribute="createdon" operator="last-x-years" value="1" />
              <condition attribute="cat_requestedfrom" operator="eq" value="{{user.id}}" />
            </filter>
            <order attribute="createdon" descending="true" />
          </entity>
        </fetch>
        {% endfetchxml %}

</script>
