// ======================= Persistent Filter Carryover =======================================
// Uses the same saved filter payload as Home page.
// Storage priority:
// 1. URL query string
// 2. sessionStorage
// 3. localStorage
// 4. Contact field

const HC_CURRENT_USER_ID = "{{ user.id | escape }}";
const HC_CONTACT_FILTER_FIELD = "cat_helpcentersavedfilters";

const HC_SESSION_FILTER_KEY = "HC_SHARED_FILTERS_SESSION_" + HC_CURRENT_USER_ID;
const HC_LOCAL_FILTER_KEY = "HC_SHARED_FILTERS_LOCAL_" + HC_CURRENT_USER_ID;

function saveFiltersToBrowser(filters) {
    if (!HC_CURRENT_USER_ID) return;

    const filterJson = JSON.stringify(filters || {});
    sessionStorage.setItem(HC_SESSION_FILTER_KEY, filterJson);
    localStorage.setItem(HC_LOCAL_FILTER_KEY, filterJson);
}

function saveSharedFilters(filters, callback) {
    if (!HC_CURRENT_USER_ID) {
        if (typeof callback === "function") callback();
        return;
    }

    saveFiltersToBrowser(filters);

    const payload = {};
    payload[HC_CONTACT_FILTER_FIELD] = JSON.stringify(filters || {});

    safeAjax({
        type: "PATCH",
        url: "/_api/contacts(" + HC_CURRENT_USER_ID + ")",
        contentType: "application/json",
        data: JSON.stringify(payload),
        success: function () {
            console.log("Help Center filters saved to Contact from My Dealership Open Cases.");
            if (typeof callback === "function") callback();
        },
        error: function (xhr) {
            console.log("Failed to save Help Center filters to Contact from My Dealership Open Cases.", xhr);
            if (typeof callback === "function") callback();
        }
    });
}

function getSharedFilters() {
    let rawValue = "";

    try {
        rawValue = sessionStorage.getItem(HC_SESSION_FILTER_KEY);
        if (rawValue) {
            return JSON.parse(rawValue) || {};
        }
    } catch (e) {
        console.log("Invalid session filter JSON.", e);
    }

    try {
        rawValue = localStorage.getItem(HC_LOCAL_FILTER_KEY);
        if (rawValue) {
            return JSON.parse(rawValue) || {};
        }
    } catch (e) {
        console.log("Invalid local filter JSON.", e);
    }

    return {};
}

function loadFiltersFromContact(callback) {
    if (!HC_CURRENT_USER_ID) {
        callback({});
        return;
    }

    safeAjax({
        type: "GET",
        url: "/_api/contacts(" + HC_CURRENT_USER_ID + ")?$select=" + HC_CONTACT_FILTER_FIELD,
        contentType: "application/json",
        headers: {
            "Accept": "application/json"
        },
        success: function (response) {
            const filterJson = response ? response[HC_CONTACT_FILTER_FIELD] : "";

            if (!filterJson) {
                callback({});
                return;
            }

            try {
                const filters = JSON.parse(filterJson) || {};
                saveFiltersToBrowser(filters);
                callback(filters);
            } catch (e) {
                console.log("Invalid saved Help Center filter JSON on Contact.", e);
                callback({});
            }
        },
        error: function (xhr) {
            console.log("Failed to load Help Center filters from Contact.", xhr);
            callback({});
        }
    });
}

function clearSharedFilters(callback) {
    sessionStorage.removeItem(HC_SESSION_FILTER_KEY);
    localStorage.removeItem(HC_LOCAL_FILTER_KEY);

    if (!HC_CURRENT_USER_ID) {
        if (typeof callback === "function") callback();
        return;
    }

    const payload = {};
    payload[HC_CONTACT_FILTER_FIELD] = null;

    safeAjax({
        type: "PATCH",
        url: "/_api/contacts(" + HC_CURRENT_USER_ID + ")",
        contentType: "application/json",
        data: JSON.stringify(payload),
        success: function () {
            console.log("Help Center filters cleared from Contact from My Dealership Open Cases.");
            if (typeof callback === "function") callback();
        },
        error: function (xhr) {
            console.log("Failed to clear Help Center filters from Contact from My Dealership Open Cases.", xhr);
            if (typeof callback === "function") callback();
        }
    });
}

function cleanFilterValue(value) {
    if (!value) return "";

    return String(value)
        .replace("{", "")
        .replace("}", "")
        .trim();
}

function buildFilterQuery(filters) {
    const params = new URLSearchParams();

    if (filters.status && filters.status.length > 0) {
        params.set("status", filters.status.join(","));
    }

    if (filters.dealerCode && filters.dealerCode.length > 0) {
        params.set("dealerCode", filters.dealerCode.join(","));
    }

    if (filters.productTech && filters.productTech.length > 0) {
        params.set("productTech", filters.productTech.join(","));
    }

    if (filters.createdFrom) {
        params.set("createdFrom", filters.createdFrom);
    }

    if (filters.createdTo) {
        params.set("createdTo", filters.createdTo);
    }

    return params.toString();
}

function getFiltersFromUrl() {
    const params = new URLSearchParams(window.location.search);

    return {
        status: params.get("status")
            ? params.get("status").split(",").map(cleanFilterValue).filter(Boolean)
            : [],

        dealerCode: params.get("dealerCode")
            ? params.get("dealerCode").split(",").map(cleanFilterValue).filter(Boolean)
            : [],

        productTech: params.get("productTech")
            ? params.get("productTech").split(",").map(cleanFilterValue).filter(Boolean)
            : [],

        createdFrom: params.get("createdFrom") || "",
        createdTo: params.get("createdTo") || ""
    };
}

function hasAnyFilter(filters) {
    return (
        (filters.status && filters.status.length > 0) ||
        (filters.dealerCode && filters.dealerCode.length > 0) ||
        (filters.productTech && filters.productTech.length > 0) ||
        filters.createdFrom ||
        filters.createdTo
    );
}

function applyTileFilterState(filters) {
    selectedCaseFilters.status = filters.status || [];
    selectedCaseFilters.dealerCode = filters.dealerCode || [];
    selectedCaseFilters.productTech = filters.productTech || [];
    selectedCaseFilters.dateOpenedFrom = filters.createdFrom || "";
    selectedCaseFilters.dateOpenedTo = filters.createdTo || "";

    restoreTileMultiSelect("status");
    restoreTileMultiSelect("dealerCode");
    restoreTileMultiSelect("productTech");

    restoreDateTimeInput(filters.createdFrom, "#dateOpenedFromDate", "#dateOpenedFromTime");
    restoreDateTimeInput(filters.createdTo, "#dateOpenedToDate", "#dateOpenedToTime");
}

function updateCurrentUrlFromFilters(filters) {
    const query = buildFilterQuery(filters);

    window.history.replaceState(
        null,
        "",
        query ? window.location.pathname + "?" + query : window.location.pathname
    );
}

function restoreTileFilters(callback) {
    let filters = getFiltersFromUrl();

    // Priority 1: URL query string
    if (hasAnyFilter(filters)) {
        saveSharedFilters(filters);
        applyTileFilterState(filters);

        if (typeof callback === "function") callback();
        return;
    }

    // Priority 2 and 3: sessionStorage, then localStorage
    filters = getSharedFilters();

    if (hasAnyFilter(filters)) {
        applyTileFilterState(filters);
        updateCurrentUrlFromFilters(filters);

        if (typeof callback === "function") callback();
        return;
    }

    // Priority 4: Contact field
    loadFiltersFromContact(function (contactFilters) {
        if (hasAnyFilter(contactFilters)) {
            applyTileFilterState(contactFilters);
            updateCurrentUrlFromFilters(contactFilters);
        }

        if (typeof callback === "function") callback();
    });
}

function restoreTileMultiSelect(filterKey) {
    const selectedValues = selectedCaseFilters[filterKey] || [];
    const box = $(".filter-select-box[data-filter-key='" + filterKey + "']");

    box.find("input[type='checkbox']").each(function () {
        const value = cleanFilterValue($(this).val());
        $(this).prop("checked", selectedValues.includes(value));
    });

    renderFilterChips(box, filterKey);
}

function restoreDateTimeInput(value, dateSelector, timeSelector) {
    if (!value) return;

    const parsedDate = new Date(value);

    if (isNaN(parsedDate.getTime())) return;

    const yyyy = parsedDate.getFullYear();
    const mm = String(parsedDate.getMonth() + 1).padStart(2, "0");
    const dd = String(parsedDate.getDate()).padStart(2, "0");
    const hh = String(parsedDate.getHours()).padStart(2, "0");
    const mi = String(parsedDate.getMinutes()).padStart(2, "0");

    $(dateSelector).val(`${yyyy}-${mm}-${dd}`);
    $(timeSelector).val(`${hh}:${mi}`);
}

function buildUtcDateTimeValue(dateValue, timeValue, mode) {
    if (!dateValue) return "";

    let finalTime = timeValue;

    if (!finalTime) {
        finalTime = mode === "start" ? "00:00" : "23:59";
    }

    const localDate = new Date(dateValue + "T" + finalTime + ":00");

    if (isNaN(localDate.getTime())) return "";

    return localDate.toISOString();
}

function buildDateTimeValue(dateValue, timeValue, mode) {
    if (!dateValue) return "";

    let finalTime = timeValue;

    if (!finalTime) {
        finalTime = mode === "start" ? "00:00" : "23:59";
    }

    return dateValue + "T" + finalTime + ":00";
}

