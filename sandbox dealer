                "Accept": "application/json",
                "Prefer": "odata.include-annotations=*"
            },
            success: function(contact) {
                callback({
                    firstname: contact.firstname || "-",
                    lastname: contact.lastname || "-",
                    email: contact.emailaddress1 || "-",
                    phone: contact.address1_telephone1 || "-",
                    personaLabel: contact["cat_persona@OData.Community.Display.V1.FormattedValue"] || "-"
                });
            },
            error: function() {
                callback({
                    firstname: "-",
                    lastname: "-",
                    email: "-",
                    phone: "-",
                    personaLabel: "-"
                });
            }
        });

    } else {

        callback({
            firstname: "-",
            lastname: "-",
            email: "-",
            phone: "-",
            personaLabel: "-"
        });

    }
} 
