function getProductTechLabelByValue(productTechValue) {
    const cleanValue = cleanFilterValue(productTechValue);

    // 1. Try Product Tech checkbox label
    const productBox = $(".filter-select-box[data-filter-key='productTech']");

    const matchingCheckbox = productBox.find(".filter-option input[type='checkbox']").filter(function () {
        return cleanFilterValue($(this).val()) === cleanValue;
    }).first();

    if (matchingCheckbox.length) {
        const checkboxLabel = matchingCheckbox.attr("data-label");

        if (checkboxLabel) {
            return checkboxLabel;
        }

        const visibleLabel = matchingCheckbox.closest("label").find("span").text().trim();

        if (visibleLabel) {
            return visibleLabel;
        }
    }

    // 2. Try hidden Product Tech source
    const matchingSourceOption = $("#listFilterOptionSource .list-product-option").filter(function () {
        return cleanFilterValue($(this).attr("data-value")) === cleanValue;
    }).first();

    if (matchingSourceOption.length) {
        const sourceLabel = matchingSourceOption.attr("data-label");

        if (sourceLabel) {
            return sourceLabel;
        }
    }

    // 3. Try row data as final Product Tech specific lookup
    const matchingRow = $("#dealerCasesTable tbody tr[data-id]").filter(function () {
        return cleanFilterValue($(this).attr("data-product-tech-value")) === cleanValue;
    }).first();

    if (matchingRow.length) {
        const rowLabel = matchingRow.attr("data-product-tech-label");

        if (rowLabel) {
            return rowLabel;
        }
    }

    // 4. Final fallback
    return cleanValue;
}

function refreshProductTechChipLabels() {
    $(".filter-select-box[data-filter-key='productTech'] .selected-filter-chip").each(function () {
        const chip = $(this);
        const value = chip.attr("data-value");

        if (!value) return;

        const label = getProductTechLabelByValue(value);

        if (!label || label === value) return;

        // Replace only the text node, keep the remove button untouched
        const textNode = chip.contents().filter(function () {
            return this.nodeType === 3;
        }).first();

        if (textNode.length) {
            textNode.replaceWith(" " + label + " ");
        }
    });
}

function buildAllowedExtensionSet(rawValue) {
    return new Set(
        String(rawValue || "")
            .replace(/\r/g, ",")
            .replace(/\n/g, ",")
            .split(",")
            .map(function (value) {
                return value
                    .trim()
                    .toLowerCase()
                    .replace(/^\./, "");
            })
            .filter(Boolean)
    );
}

