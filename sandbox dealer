    }
});

function sortDealerCaseRows(sortKey, sortType, direction) {
    const tbody = $("#dealerCasesTable tbody");
    const rows = tbody.find("tr[data-id]").get();

    rows.sort(function (rowA, rowB) {
        const valueA = getSortableValue($(rowA), sortKey, sortType);
        const valueB = getSortableValue($(rowB), sortKey, sortType);

        let comparison = 0;

        if (sortType === "datetime") {
            comparison = valueA - valueB;
        } else {
            comparison = String(valueA).localeCompare(String(valueB), undefined, {
                numeric: true,
                sensitivity: "base"
            });
        }

        return direction === "asc" ? comparison : comparison * -1;
    });

    rows.forEach(function (row) {
        tbody.append(row);
    });
}

function getSortableValue(row, sortKey, sortType) {
    let value = "";

    if (sortKey === "caseNumber") {
        value = row.attr("data-sort-case-number") || "";
    }

    if (sortKey === "dateOpened") { 1       
        value = row.attr("data-sort-date-opened") || "";
