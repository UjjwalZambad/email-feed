function getPortalUploadedByName(noteText) {
    if (!noteText) return "";

    const match = String(noteText).match(/PortalUploadedBy=([^;]+)/i);

    if (!match || !match[1]) return "";

    return match[1].trim();
}

function loadCaseAttachments(caseId, panel) {
    const tbody = panel.find(".case-attachments-table tbody");
    const summary = panel.find(".case-attachments-summary");

    const cleanCaseId = cleanGuid(caseId);

    panel.find(".case-attachment-message")
        .removeClass("error success info")
        .text("");

    summary.text("Attachments");
    tbody.html(`<tr><td colspan="5">Loading...</td></tr>`);

    const url =
        "/_api/annotations" +
        "?$select=annotationid,subject,notetext,filename,filesize,modifiedon,mimetype,isdocument,_ownerid_value,_objectid_value" +
        "&$filter=_objectid_value eq " + cleanCaseId + " and isdocument eq true" +
        "&$orderby=modifiedon desc";

    safeAjax({
        type: "GET",
        url: url,
        contentType: "application/json",
        headers: {
            "Accept": "application/json",
            "Prefer": 'odata.include-annotations="OData.Community.Display.V1.FormattedValue"'
        },
        success: function (response) {
            renderCaseAttachmentRows(response.value || [], panel);
        },
        error: function (xhr) {
            console.error("Attachment load failed");
            console.error("Status:", xhr.status);
            console.error("Response:", xhr.responseText);

            summary.text("Attachments");

            tbody.html(`
                <tr>
                    <td colspan="5" class="case-attachments-empty">
                        Unable to load attachments
                    </td>
                </tr>
            `);

            showCaseAttachmentMessage(
                panel,
                "error",
                "Unable to load attachments. Status: " +
                xhr.status +
                ". Check console responseText for the exact Web API error."
            );
        }
    });
}

function cleanGuid(value) {
    return String(value || "")
        .replace("{", "")
        .replace("}", "")
        .trim();
}

function renderCaseAttachmentRows(records, panel) {
    const tbody = panel.find(".case-attachments-table tbody");
    const summary = panel.find(".case-attachments-summary");

    if (!records || records.length === 0) {
        summary.text("0 files");

        tbody.html(`
            <tr>
                <td colspan="5" class="case-attachments-empty">
                    No attachments found
                </td>
            </tr>
        `);

        return;
    }

    const totalSize = records.reduce(function (sum, item) {
        return sum + Number(item.filesize || 0);
    }, 0);

    summary.text(
        records.length +
        " file" +
        (records.length === 1 ? "" : "s") +
        " | Total size: " +
        formatCaseAttachmentSize(totalSize)
    );

    let html = "";

    records.forEach(function (item) {
        const title =
            item.subject ||
            removeCaseAttachmentExtension(item.filename) ||
            item.filename ||
            "-";

        let owner =
            getPortalUploadedByName(item.notetext) ||
            item["_ownerid_value@OData.Community.Display.V1.FormattedValue"] ||
            "-";

        // Optional: hide managed identity-looking owner names
        if (owner.indexOf("PPMI-") >= 0 || owner.indexOf("powerpagesmanagedidentity") >= 0) {
            owner =
                window.portalCurrentContact && window.portalCurrentContact.name
                    ? window.portalCurrentContact.name
                    : "-";
        }
        const modifiedOn =
            item["modifiedon@OData.Community.Display.V1.FormattedValue"] ||
            formatCaseAttachmentDate(item.modifiedon);

        html += `
            <tr>
                <td>
                    <span class="case-file-icon">
                        ${escapeHtml(getCaseAttachmentExtensionLabel(item.filename))}
                    </span>
                    <span class="case-file-title">
                        ${escapeHtml(title)}
                    </span>
                </td>

                <td>${escapeHtml(owner)}</td>

                <td>${escapeHtml(modifiedOn)}</td>

                <td>${escapeHtml(formatCaseAttachmentSize(item.filesize))}</td>

                <td>
                    <button
                        type="button"
                        class="case-download-attachment-btn"
                        title="Download"
                        data-annotation-id="${escapeAttribute(item.annotationid)}">
                        <span class="download-icon-svg" aria-hidden="true">
                            <svg width="18" height="18" viewBox="0 0 24 24" fill="none">
                                <path d="M12 3V15" stroke="currentColor" stroke-width="1.7" stroke-linecap="round"/>
                                <path d="M7 10L12 15L17 10" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"/>
                                <path d="M5 20H19" stroke="currentColor" stroke-width="1.7" stroke-linecap="round"/>
                            </svg>
