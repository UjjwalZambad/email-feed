// ==================== FILTERING LOGIC ====================

function getFilteredCaseRows() {
    return getAllCaseRows().filter(function () {
        const row = $(this);

        const rowStatus = cleanFilterValue(row.attr("data-status-value") || "");
        const rowDealerCode = cleanFilterValue(row.attr("data-dealer-code") || "");
        const rowProductTech = cleanFilterValue(row.attr("data-product-tech-value") || "");
        const rowCreatedOn = row.attr("data-created-on") || "";

        if (selectedCaseFilters.status.length > 0) {
            const matched = selectedCaseFilters.status.some(function (value) {
                return rowStatus === cleanFilterValue(value);
            });

            if (!matched) return false;
        }

        if (selectedCaseFilters.dealerCode.length > 0) {
            const matched = selectedCaseFilters.dealerCode.some(function (value) {
                return rowDealerCode === cleanFilterValue(value);
            });

            if (!matched) return false;
        }

        if (selectedCaseFilters.productTech.length > 0) {
            const matched = selectedCaseFilters.productTech.some(function (value) {
                return rowProductTech === cleanFilterValue(value);
            });

            if (!matched) return false;
        }

        if (selectedCaseFilters.dateOpenedFrom) {
            if (!rowCreatedOn || rowCreatedOn < selectedCaseFilters.dateOpenedFrom) {
                return false;
            }
        }

        if (selectedCaseFilters.dateOpenedTo) {
            if (!rowCreatedOn || rowCreatedOn > selectedCaseFilters.dateOpenedTo) {
                return false;
            }
        }

        return true;
    });
}

// ==================== APPLY FILTER + PAGINATION ====================

function applyCaseFiltersAndPaginate() {
    $(".case-details").remove();

    caseCurrentPage = 1;
    showCasePage(caseCurrentPage);
    updateFilterButtonState();
}

function showCasePage(page) {
    const allRows = getAllCaseRows();
    const filteredRows = getFilteredCaseRows();

    $(".case-details").remove();
    $(".no-filter-results-row").remove();

    allRows.hide();

    if (filteredRows.length === 0) {
        showNoFilteredRecordsRow(true);
        $("#dealerPagination").empty();
        return;
    }

    showNoFilteredRecordsRow(false);

    const totalPages = Math.ceil(filteredRows.length / caseRowsPerPage) || 1;

    if (page < 1) page = 1;
    if (page > totalPages) page = totalPages;

    caseCurrentPage = page;

    const start = (caseCurrentPage - 1) * caseRowsPerPage;
    const end = start + caseRowsPerPage;

    filteredRows.slice(start, end).show();

    renderCasePagination(totalPages, filteredRows.length);
}

function renderCasePagination(totalPages, totalRecords) {

    let html = "";

    const startRecord = ((caseCurrentPage - 1) * caseRowsPerPage) + 1;
    const endRecord = Math.min(caseCurrentPage * caseRowsPerPage, totalRecords);

    html += `
        <div class="pagination-footer">
            <div class="record-info">
                Viewing ${startRecord}-${endRecord} of ${totalRecords}
            </div>

            <div class="pagination-buttons">

                <button class="page-btn prev-btn"
                    ${caseCurrentPage === 1 ? "disabled" : ""}
                    data-page="${caseCurrentPage - 1}">
                    &#10094;
                </button>
    `;

    // Always show first page
    html += `
        <button class="page-btn page-number ${caseCurrentPage === 1 ? "active" : ""}"
            data-page="1">
            1
        </button>
    `;

    let startPage = Math.max(2, caseCurrentPage - 1);
    let endPage = Math.min(totalPages - 1, caseCurrentPage + 1);

    // Beginning pages
    if (caseCurrentPage <= 3) {
        startPage = 2;
        endPage = Math.min(4, totalPages - 1);
    }

    // Ending pages
    if (caseCurrentPage >= totalPages - 2) {
        startPage = Math.max(2, totalPages - 3);
        endPage = totalPages - 1;
    }

    // Left ellipsis
    if (startPage > 2) {
        html += `
            <button class="page-btn page-ellipsis"
                data-page="${startPage - 2}">
                ...
            </button>
        `;
    }

    // Middle pages
    for (let i = startPage; i <= endPage; i++) {
        html += `
            <button class="page-btn page-number ${caseCurrentPage === i ? 'active' : ''}"
                data-page="${i}">
                ${i}
            </button>
        `;
    }

    // Right ellipsis
    if (endPage < totalPages - 1) {
        html += `
            <button class="page-btn page-ellipsis"
                data-page="${endPage + 2}">
                ...
            </button>
        `;
    }

    // Last Page
    if (totalPages > 1) {
        html += `
            <button class="page-btn page-number ${caseCurrentPage === totalPages ? 'active' : ''}"
                data-page="${totalPages}">
                ${totalPages}
            </button>
        `;
    }

    html += `
                <button class="page-btn next-btn"
                    ${caseCurrentPage === totalPages ? "disabled" : ""}
                    data-page="${caseCurrentPage + 1}">
                    &#10095;
                </button>
            </div>
        </div>
    `;

    $("#dealerPagination").html(html);

    // Page click
    $(".page-number, .page-ellipsis").off("click").on("click", function () {
        caseCurrentPage = parseInt($(this).data("page"));
        loadCases();
    });

    // Previous
    $(".prev-btn").off("click").on("click", function () {
        if (caseCurrentPage > 1) {
            caseCurrentPage--;
            loadCases();
        }
    });

    // Next
    $(".next-btn").off("click").on("click", function () {
        if (caseCurrentPage < totalPages) {
            caseCurrentPage++;
            loadCases();
        }
    });
}






$(document).on("click", ".page-number", function () {
