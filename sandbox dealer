<script>

  // ==================== EXPORT TO REAL XLSX ====================

$(document).on("click", "#exportDealerCases", function (e) {
    e.preventDefault();
    e.stopPropagation();

    exportDealerCasesToXlsx();
});

function exportDealerCasesToXlsx() {

    if (typeof XLSX === "undefined") {
        console.error("XLSX library is not loaded.");
        alert("Excel export library is not loaded. Please check that xlsx.full.min.js is loaded.");
        return;
    }

    const exportData = [];

    // Header row
    exportData.push([
        "Case Number",
        "Date Opened",
        "Subject",
        "Description"
    ]);

    // Export all rendered FetchXML rows, including hidden paginated rows
    $("#dealerCasesTable tbody tr[data-id]").each(function () {

        const rowData = [];

        $(this).find("td").each(function () {
            rowData.push(cleanExcelText($(this).text()));
        });

        exportData.push(rowData);
    });

    if (exportData.length <= 1) {
        alert("No cases available to export.");
        return;
    }

    const workbook = XLSX.utils.book_new();

    const worksheet = XLSX.utils.aoa_to_sheet(exportData);

    // Optional column widths
    worksheet["!cols"] = [
        { wch: 20 },
        { wch: 22 },
        { wch: 40 },
        { wch: 80 }
    ];

    // Optional autofilter
    worksheet["!autofilter"] = {
        ref: XLSX.utils.encode_range({
            s: { r: 0, c: 0 },
            e: {
                r: exportData.length - 1,
                c: exportData[0].length - 1
            }
        })
    };

    XLSX.utils.book_append_sheet(workbook, worksheet, "Open Cases");

    const fileName = "Dealership_Open_Cases_" + getCurrentDateString() + ".xlsx";

   XLSX.writeFile(workbook, fileName);
//    try {
//     XLSX.writeFile(workbook, fileName);

//     alert("Excel file downloaded successfully.");
// } catch (error) {
//     console.error("Excel export failed:", error);

//     alert("Unable to download the Excel file. Please try again.");
// }
}

function cleanExcelText(value) {
    if (!value) return "";
    return value.replace(/\s+/g, " ").trim();
}

function getCurrentDateString() {
    const today = new Date();

    const yyyy = today.getFullYear();
    const mm = String(today.getMonth() + 1).padStart(2, "0");
    const dd = String(today.getDate()).padStart(2, "0");

    return `${yyyy}-${mm}-${dd}`;
}

</script>

