function normalizeText(value) {
    if (!value) return "";

    return String(value)
        .replace(/\s+/g, " ")
        .trim()
        .toLowerCase();
}

function escapeHtml(value) {
    if (!value) return "";

    return String(value)
        .replace(/&/g, "&amp;")
        .replace(/</g, "&lt;")
        .replace(/>/g, "&gt;")
        .replace(/"/g, "&quot;")
        .replace(/'/g, "&#039;");
}

function escapeAttribute(value) {
