function renderEmailFeedPagination() {

    const totalRecords = emailFeedRecords.length;
    const totalPages = Math.ceil(totalRecords / emailFeedPageSize);

    if (totalRecords === 0) {
        return "";
    }

    const startRecord =
        ((emailFeedCurrentPage - 1) * emailFeedPageSize) + 1;

    const endRecord =
        Math.min(
            emailFeedCurrentPage * emailFeedPageSize,
            totalRecords
        );

    let html = `
        <div class="email-pagination-footer">

            <div class="email-record-info">
                Viewing ${startRecord}-${endRecord} of ${totalRecords}
            </div>

            <div class="email-pagination-buttons">

                <button
                    class="email-page-btn"
                    data-page="${emailFeedCurrentPage - 1}"
                    ${emailFeedCurrentPage === 1 ? "disabled" : ""}>
                    ❮
                </button>

                <button
                    class="email-page-btn active"
                    data-page="${emailFeedCurrentPage}">
                    ${emailFeedCurrentPage}
                </button>

                <button
                    class="email-page-btn"
                    data-page="${emailFeedCurrentPage + 1}"
                    ${emailFeedCurrentPage === totalPages ? "disabled" : ""}>
                    ❯
                </button>

            </div>

        </div>
    `;

    return html;
}

$(document).on(
