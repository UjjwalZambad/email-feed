function downloadCaseAttachment(annotationId) {
    const url =
        "/_api/" + CASE_ATTACHMENT_API.entitySetName +
        "(" + annotationId + ")" +
        "?$select=documentbody,filename,mimetype";

    safeAjax({
        type: "GET",
        url: url,
        contentType: "application/json",
        headers: {
            "Accept": "application/json"
        },
        success: function (record) {
            if (!record || !record.documentbody) {
                alert("File content was not found.");
                return;
            }

            const fileName = record.filename || "attachment";
            const mimeType = record.mimetype || "application/octet-stream";

            const blob = base64ToCaseAttachmentBlob(record.documentbody, mimeType);
            const blobUrl = URL.createObjectURL(blob);

            const link = document.createElement("a");
            link.href = blobUrl;
            link.download = fileName;

            document.body.appendChild(link);
            link.click();

            document.body.removeChild(link);
            URL.revokeObjectURL(blobUrl);
        },
        error: function (xhr) {
            console.error("Attachment download failed:", xhr);
            alert("Unable to download attachment.");
        }
    });
}


// ==================== VALIDATE + UPLOAD ====================

function handleCaseAttachmentFiles(caseId, files, panel) {
    panel.find(".case-attachment-message")
        .removeClass("error success info")
        .text("");

    const selectedFiles = Array.from(files || []);

    console.log("Allowed attachment extensions:", Array.from(CASE_ATTACHMENT_ALLOWED_EXT));
    console.log("Max files per upload:", CASE_ATTACHMENT_MAX_FILES_PER_UPLOAD);
    console.log("Max file size MB:", CASE_ATTACHMENT_MAX_FILE_SIZE_MB);

    // ================================
    // 1. Validate max files per upload
    // ================================
    if (selectedFiles.length > CASE_ATTACHMENT_MAX_FILES_PER_UPLOAD) {
        showCaseAttachmentMessage(
            panel,
            "error",
            "You can upload a maximum of " +
            CASE_ATTACHMENT_MAX_FILES_PER_UPLOAD +
            " files at a time."
        );
        return;
    }

    const rejectedType = [];
    const rejectedTooBig = [];
    const validFiles = [];

    // ================================
    // 2. Validate each file
    // ================================
    selectedFiles.forEach(function (file) {
        const ext = getCaseAttachmentExt(file.name);
        const size = Number(file.size || 0);

        console.log("Selected file:", file.name, "Extension:", ext, "Size:", size);

        // File type validation
        if (!CASE_ATTACHMENT_ALLOWED_EXT.has(ext)) {
            rejectedType.push(file.name);
            return;
        }

        // Per-file size validation
        if (size > CASE_ATTACHMENT_MAX_FILE_SIZE_BYTES) {
            rejectedTooBig.push(
                file.name + " (" + formatCaseAttachmentSize(size) + ")"
            );
            return;
        }

        validFiles.push(file);
    });

    // ================================
    // 3. Show file type error
    // ================================
    if (rejectedType.length > 0) {
        showCaseAttachmentMessage(
            panel,
            "error",
            "These file types are not allowed: " +
            rejectedType.join(", ") +
            ". Allowed types: " +
            Array.from(CASE_ATTACHMENT_ALLOWED_EXT).join(", ")
        );
        return;
    }

    // ================================
    // 4. Show per-file size error
    // ================================
    if (rejectedTooBig.length > 0) {
        showCaseAttachmentMessage(
            panel,
            "error",
            "Each file must be " +
            CASE_ATTACHMENT_MAX_FILE_SIZE_MB +
            " MB or smaller. These files exceed the limit: " +
            rejectedTooBig.join(", ")
        );
        return;
    }

    if (validFiles.length === 0) {
        return;
    }

    uploadCaseAttachments(caseId, validFiles, panel);
}

function uploadCaseAttachments(caseId, files, panel) {
    showCaseAttachmentMessage(panel, "info", "Uploading attachment...");

    const uploadPromises = files.map(function (file) {
        return uploadSingleCaseAttachment(caseId, file);
    });

    Promise.all(uploadPromises)
        .then(function () {
            showCaseAttachmentMessage(panel, "success", "Attachment uploaded successfully.");

            // Mark attachment panel as needing refresh
            panel.attr("data-attachments-loaded", "false");

            // Reload attachments after upload
            loadCaseAttachments(caseId, panel);

            // Mark as loaded again
            panel.attr("data-attachments-loaded", "true");
        })
        .catch(function (error) {
            console.error("Attachment upload failed:", error);
            showCaseAttachmentMessage(panel, "error", "Unable to upload attachment.");
        });
}

function uploadSingleCaseAttachment(caseId, file) {
    return new Promise(function (resolve, reject) {
        const reader = new FileReader();

        reader.onload = function (e) {
            const base64Content = String(e.target.result).split(",")[1];
            const ext = getCaseAttachmentExt(file.name);

            const mimeType =
                file.type ||
                CASE_ATTACHMENT_MIME_TYPES[ext] ||
                "application/octet-stream";

            const cleanCaseId = cleanGuid(caseId);

            const portalContactName =
                window.portalCurrentContact && window.portalCurrentContact.name
                    ? window.portalCurrentContact.name
                    : "";

            const portalContactId =
                window.portalCurrentContact && window.portalCurrentContact.id
                    ? window.portalCurrentContact.id
                    : "";

            const payload = {
                "filename": file.name,
                "documentbody": base64Content,
                "subject": removeCaseAttachmentExtension(file.name),
                "mimetype": mimeType,
                "isdocument": true,

                // Store portal contact info for display in the custom grid
                "notetext":
                    "*WEB* " +
                    "PortalUploadedBy=" + portalContactName +
                    "; PortalUploadedByContactId=" + portalContactId,

                "objectid_incident@odata.bind": "/incidents(" + cleanCaseId + ")"
            };
            console.log("Uploading annotation payload:", payload);

            safeAjax({
                type: "POST",
                url: "/_api/annotations",
                contentType: "application/json",
                data: JSON.stringify(payload),
                processData: false,
                headers: {
                    "Accept": "application/json"
                },
                success: function (data, textStatus, xhr) {
                    console.log("Attachment uploaded successfully.");
                    console.log("Created record:", xhr.getResponseHeader("entityid"));
                    resolve();
                },
                error: function (xhr) {
                    console.error("Attachment upload failed");
                    console.error("Status:", xhr.status);
                    console.error("Response:", xhr.responseText);
                    reject(xhr);
                }
            });
        };

        reader.onerror = function (error) {
            reject(error);
        };

        reader.readAsDataURL(file);
    });
}

