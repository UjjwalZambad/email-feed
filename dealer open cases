<th class="sortable-header" data-sort-key="description" data-sort-type="text">
      Description <span class="sort-arrow"></span>
</tr>
</thead>
 
    <tbody>
    {% if testcases11.results.entities.size > 0 %}

        {% for case in testcases11.results.entities %}

<tr   
  data-id="{{ case.incidentid }}"
  data-status-value="{{ case.cat_helpcenterstatus.value | default: case.cat_helpcenterstatus | default: '' | escape }}"
  data-status-label="{{ case.cat_helpcenterstatus.label | default: case.cat_helpcenterstatus | default: '' | escape }}"
  data-dealer-code="{{ case.cat_dealercode | default: '' | escape }}"
  data-product-tech-value="{{ case.productid.id | default: case.productid | default: '' | escape }}"
  data-product-tech-label="{{ case.productid.name | default: case.producttechnology | default: '' | escape }}"
  data-created-on="{{ case.createdon | date: 'yyyy-MM-ddTHH:mm:ss' }}"

  data-sort-case-number="{{ case.ticketnumber | default: '' | escape }}"
  data-sort-date-opened="{{ case.createdon | date: 'yyyy-MM-ddTHH:mm:ss' }}"
  data-sort-subject="{{ case.title | default: '' | escape}}"
  data-sort-description="{{ case.description | default: '' | escape }}"
>
<td>{{ case.ticketnumber }}</td>
<td>{{ case.createdon }}</td>
<td class="truncate-cell subject-cell" data-full="{{ case.title | default: '' | escape }}">
  {{ case.title }}
</td>
<td class="truncate-cell description-cell" data-full="{{ case.description | default: '' | strip_html | escape }}">
  {{ case.description }}
</td>
</tr>


{% endfor %}

{% endif %}
</tbody>
</table>
