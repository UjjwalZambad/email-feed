<div id="iwjt7g" class="row sectionBlockLayout text-start" style="display: flex; flex-wrap: wrap; margin: 0px; min-height: auto; padding: 8px;">
  <div id="i7mtpj" class="container" style="padding: 0px; display: flex; flex-wrap: wrap; max-width: 100%;"><div class="col-lg-12 columnBlockLayout" style="flex-grow: 1; display: flex; flex-direction: column; min-width: 250px; margin-top: 0;"><h2 class="mpc-header">My Dealership Open Cases</h2>
