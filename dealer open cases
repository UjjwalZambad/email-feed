<div class="table-wrapper">
<table class="table table-hover" id="dealerCasesTable">
<thead>
<tr>
<th class="sortable-header" data-sort-key="caseNumber" data-sort-type="text">
      Case Number <span class="sort-arrow"></span>
    </th>
<th class="sortable-header" data-sort-key="dateOpened" data-sort-type="datetime">
      Date Opened <span class="sort-arrow"></span>
    </th>
<th class="sortable-header" data-sort-key="subject" data-sort-type="text">
