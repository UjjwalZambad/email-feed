<script>

(function(webapi, $) {
  function safeAjax(ajaxOptions) {
    var deferredAjax = $.Deferred();
    shell.getTokenDeferred().done(function(token) {
      if (!ajaxOptions.headers) {
        $.extend(ajaxOptions, {
          headers: {
            "__RequestVerificationToken": token
          }
        });
      } else {
        ajaxOptions.headers["__RequestVerificationToken"] = token;
      }
      $.ajax(ajaxOptions).done(function(data, textStatus, jqXHR) {
        validateLoginSession(data, textStatus, jqXHR, deferredAjax.resolve);
      }).fail(deferredAjax.reject);
    }).fail(function() {
      deferredAjax.rejectWith(this, arguments);
    });
    return deferredAjax.promise();
  }
  webapi.safeAjax = safeAjax;
})(window.webapi = window.webapi || {}, jQuery);

</script>

<script>
function refreshCaseCounts() {
   const userId = "{{ user.id }}".replace(/[{}]/g, "").trim();
   if (!userId) {
       console.error("Unable to determine logged-in user ID.");
       return;
   }
   console.log("Refreshing case counts for user:", userId);

   // ============================================================
   // 1. OPEN CASES COUNT
   // ============================================================
   const oneYearAgo = new Date();
   oneYearAgo.setFullYear(oneYearAgo.getFullYear() - 1);
   const createdOnDate = oneYearAgo.toISOString();
   const openCasesFilter =
       "_cat_requestedfrom_value eq " + userId +
       " and parentcaseid eq null" +
       " and createdon ge " + createdOnDate +
       " and (" +
           "cat_helpcenterstatus eq 100000000" +
           " or cat_helpcenterstatus eq 100000001" +
           " or cat_helpcenterstatus eq 100000002" +
           " or cat_helpcenterstatus eq 100000003" +
           " or cat_helpcenterstatus eq 100000004" +
           " or cat_helpcenterstatus eq 100000005" +
       ")";
   const openCasesUrl =
       "/_api/incidents" +
       "?$select=incidentid" +
       "&$filter=" + encodeURIComponent(openCasesFilter) +
       "&$count=true";

   webapi.safeAjax({
       type: "GET",
       url: openCasesUrl,
       contentType: "application/json",
       success: function (result) {
           let count = 0;
           if (result && result["@odata.count"] !== undefined) {
               count = result["@odata.count"];
           }
           else if (result && result.value) {
               count = result.value.length;
           }
           const countElement =
               document.getElementById("openCasesCount");
           if (countElement) {
               countElement.textContent = count;
           }
           console.log("Open Cases Count:", count);
       },
       error: function (xhr) {
           console.error("Unable to refresh Open Cases count.");
           console.error("Status:", xhr.status);
           console.error("Response:", xhr.responseText);
       }
   });

   // ============================================================
   // 2. DEALERSHIP OPEN CASES COUNT
   // ============================================================
   const isDealer =
       {% if user.roles contains "Cat_Dealer Persona Role" %}
           true
       {% else %}
           false
       {% endif %};
   const isInternalCustomer =
       {% if user.roles contains "Cat_Internal Customer Persona Role" %}
           true
       {% else %}
           false
       {% endif %};

   // ============================================================
   // INTERNAL CUSTOMER
   // ============================================================
   if (isInternalCustomer) {
       const dealershipFilter =
           "statecode eq 0" +
           " and parentcaseid eq null";
       const dealershipUrl =
           "/_api/incidents" +
           "?$select=incidentid" +
           "&$filter=" + encodeURIComponent(dealershipFilter) +
           "&$count=true";

       webapi.safeAjax({
           type: "GET",
           url: dealershipUrl,
           contentType: "application/json",
           success: function (result) {
               console.log(
                   "Internal Customer Dealership Cases API response:",
                   result
               );
               let count = 0;
               if (
                   result &&
                   result["@odata.count"] !== undefined
               ) {
                   count = result["@odata.count"];
               }
               else if (result && result.value) {
                   count = result.value.length;
               }
               const countElement =
                   document.getElementById(
                       "dealershipCasesCount"
                   );
               if (countElement) {
                   countElement.textContent = count;
               }
               console.log(
                   "Internal Customer Dealership Cases Count:",
                   count
               );
           },
           error: function (xhr) {
               console.error(
                   "Unable to refresh Internal Dealership Cases count."
               );
               console.error("Status:", xhr.status);
               console.error("Response:", xhr.responseText);
           }
       });
   }

   // ============================================================
   // DEALER
   // ============================================================
   else if (isDealer) {
       const dealerId =
           "{{ user.parentcustomerid.id }}"
           .replace(/[{}]/g, "")
           .trim();
       if (!dealerId) {
           console.error(
               "Unable to determine dealer account ID."
           );
           return;
       }
       console.log("Dealer Account ID:", dealerId);

       const dealershipFilter =
           "statecode eq 0" +
           " and parentcaseid eq null" +
           " and (" +
               "_customerid_value eq " + dealerId +
               " or customerid_account/parentaccountid eq " +
               dealerId +
               " or customerid_contact/_parentcustomerid_value eq " +
               dealerId +
               " or cat_requestedfrom_contact/_parentcustomerid_value eq " +
               dealerId +
               " or _cat_dealername_value eq " +
               dealerId +
           ")";

       const dealershipUrl =
           "/_api/incidents" +
           "?$select=incidentid" +
           "&$filter=" + encodeURIComponent(dealershipFilter) +
           "&$count=true";

       console.log(
           "Dealer Dealership Cases URL:",
           dealershipUrl
       );

       webapi.safeAjax({
           type: "GET",
           url: dealershipUrl,
           contentType: "application/json",
           success: function (result) {
               console.log(
                   "Dealer Dealership Cases API response:",
                   result
               );
               let count = 0;
               if (
                   result &&
                   result["@odata.count"] !== undefined
               ) {
                   count = result["@odata.count"];
               }
               else if (result && result.value) {
                   count = result.value.length;
               }
               const countElement =
                   document.getElementById(
                       "dealershipCasesCount"
                   );
               if (countElement) {
                   countElement.textContent = count;
               }
               console.log(
                   "Dealer Dealership Cases Count:",
                   count
               );
           },
           error: function (xhr) {
               console.error(
                   "Unable to refresh Dealer Dealership Cases count."
               );
               console.error("Status:", xhr.status);
               console.error("Response:", xhr.responseText);
           }
       });
   }
}

document.addEventListener("DOMContentLoaded", function () {

    // Initial refresh

    refreshCaseCounts();

    // Refresh both counts every 30 seconds

    setInterval(function () {

        refreshCaseCounts();

    }, 30000);

});  
</script>
 
 
