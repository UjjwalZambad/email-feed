  </div>
 
  <div class="tile-settings-footer">
    <button class="btn btn-warning" onclick="saveTileSettings()">Save</button>
  </div>
 
</div>

<script>

const tilePreferenceColumn = "cat_tilepreferences";
const tileMappings = [{
  key: "tile-cases-by-status",
  tileId: "tile-cases-by-status",
  checkboxId: "chk-cases-by-status"
}, {
  key: "tile-cases-by-status-chart",
  tileId: "tile-cases-by-status-chart",
  checkboxId: "chk-cases-by-status-chart"
}];

function openTileSettings() {
  document.getElementById("tileSettingsPanel").classList.add("open");
}

function closeTileSettings() {
  document.getElementById("tileSettingsPanel").classList.remove("open");
}

function collectTilePreferences() {
  const preferences = {};
  tileMappings.forEach(function(item) {
    const checkbox = document.getElementById(item.checkboxId);
    if (checkbox) {
      preferences[item.key] = checkbox.checked;
    }
  });
  return preferences;
}

function applyTileVisibilityFromPreferences(preferences) {
  tileMappings.forEach(function(item) {
    const tile = document.getElementById(item.tileId);
    const checkbox = document.getElementById(item.checkboxId);
    let isVisible = true;
    if (preferences && Object.prototype.hasOwnProperty.call(preferences, item.key)) {
      isVisible = preferences[item.key];
    }
    if (tile) {
      tile.style.display = isVisible ? "block" : "none";
    }
    if (checkbox) {
      checkbox.checked = isVisible;
    }
  });
}

function saveTileSettings() {
  const preferences = collectTilePreferences();
  const dataToSave = {};
  dataToSave[tilePreferenceColumn] = JSON.stringify(preferences);
  webapi.safeAjax({
    type: "PATCH",
    url: "/_api/contacts({{ user.id }})",
    contentType: "application/json",
    data: JSON.stringify(dataToSave),
    success: function() {
      applyTileVisibilityFromPreferences(preferences);
      closeTileSettings();
      console.log("Tile preferences saved successfully.");
    },
    error: function(xhr) {
      console.error("Error saving tile preferences:", xhr.responseText);
      alert("Tile preferences could not be saved. Please check Contact table permission and Web API settings.");
    }
  });
}

function loadTileSettings() {
  webapi.safeAjax({
    type: "GET",
    url: "/_api/contacts({{ user.id }})?$select=" + tilePreferenceColumn,
    contentType: "application/json",
    success: function(result) {
      let preferences = null;
      if (result && result[tilePreferenceColumn]) {
        try {
          preferences = JSON.parse(result[tilePreferenceColumn]);
        } catch (e) {
          console.error("Invalid tile preference JSON:", e);
        }
      }
      applyTileVisibilityFromPreferences(preferences);
    },
    error: function(xhr) {
      console.error("Error loading tile preferences:", xhr.responseText);
      applyTileVisibilityFromPreferences(null);
    }
  });
}
document.addEventListener("DOMContentLoaded", function() {
  loadTileSettings();
});

</script>


