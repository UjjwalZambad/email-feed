/* ===== LIST: only Subject / Description truncated ===== */
#dealerCasesTable tbody tr:hover td {
    background-color: #ffffff !important;
}

#dealerCasesTable {
    table-layout: auto !important;
    width: 100% !important;
}

#dealerCasesTable tbody tr[data-id] > td {
    white-space: nowrap !important;
}

#dealerCasesTable td.truncate-cell {
    overflow: hidden !important;
    vertical-align: middle !important;
}

#dealerCasesTable .cell-ellipsis {
    display: block;
    width: 300px;
    max-width: 300px;
    overflow: hidden;
    white-space: nowrap;
    text-overflow: ellipsis;
    font-family: "NotoSans", "Noto Sans", sans-serif;
    font-size: 14px;
    font-weight: 400;
    line-height: 20px;
    color: #3f3f3f;
}

#dealerCasesTable tr.case-details > td {
    white-space: normal !important;
    overflow: visible !important;
}

/* ===== EXPANDED / MOBILE: Description same style as other values ===== */
.case-description-value {
    display: block;
    width: 100%;
    max-width: 100%;
    min-width: 0;
    margin: 4px 0 0 0;
    font-family: "NotoSans", "Noto Sans", sans-serif !important;
    font-size: 14px !important;
    line-height: 20px !important;
    font-weight: 400 !important;
    color: #3f3f3f !important;
    white-space: normal !important;
    overflow-wrap: anywhere !important;
    word-break: break-word !important;
}

.case-description-value * {
    font-family: inherit !important;
    font-size: inherit !important;
    line-height: inherit !important;
    color: inherit !important;
    background: transparent !important;
    background-color: transparent !important;
    white-space: normal !important;
    overflow-wrap: anywhere !important;
    word-break: break-word !important;
    width: auto !important;
    max-width: 100% !important;
    min-width: 0 !important;
}

.case-description-value p,
.case-description-value div {
    margin: 0 0 6px 0 !important;
    padding: 0 !important;
}




/* ===== HANDUP DETAILS POPUP (outer frame) ===== */
#casePopupModal .case-popup-content {
    width: min(1200px, 92vw);
    height: 90vh;
    max-height: 90vh;
    border-radius: 8px;
}

#casePopupModal .case-popup-header {
    flex: 0 0 auto;
    padding: 14px 24px;
}

#casePopupModal .case-popup-header h3 {
    margin: 0;
    font-family: "NotoSans", "Noto Sans", sans-serif;
    font-size: 20px;
    font-weight: 600;
    color: #1a1a1a;
}

#casePopupModal #casePopupFrame {
    flex: 1 1 auto;
    min-height: 0;
    display: block;
}

#casePopupModal .button-container {
    flex: 0 0 auto;
    padding: 14px 24px;
    border-top: 1px solid #ddd;
    background: #fff;
}






