<!-- ===================== LANGUAGE CONFIG (authenticated only) ===================== -->
{% if user %}
  {% fetchxml catLangConfig %}
  <fetch top="1">
    <entity name="cat_ccs_configuration">
      <attribute name="cat_value" />
      <filter>
        <condition attribute="cat_key" operator="eq" value="CAT_Web_Languages" />
      </filter>
    </entity>
  </fetch>
  {% endfetchxml %}
  <script type="application/json" id="catWebLanguagesConfig">
  {{ catLangConfig.results.entities[0].cat_value | default: '[]' }}
  </script>
{% else %}
  <script type="application/json" id="catWebLanguagesConfig">[]</script>
{% endif %}

<!-- ===================== Analytics URL parameter capture (OneTrust gated) ===================== -->
<script type="text/plain" class="optanon-category-C0003">
(function () {
    var map = {
        "primeproductfamily":"Prime Product Family","machinemodel":"Machine Model","url":"URL",
        "userstate":"User State","language":"Language","esite":"eSite","currentpage":"Current Page",
        "serialnumber":"Serial Number","dcn":"DCN","referenceid":"Reference ID","geoloc":"Geolocation",
        "usertype":"User Type","dealercode":"Dealer Code","trackingid":"Tracking ID",
        "applicationversion":"Application Version","currentscreenname":"Current Screen Name",
        "selecteddealerid":"Selected Dealer ID","selecteddealername":"Selected Dealer Name",
        "selecteddealerstoreid":"Selected Dealer Store ID","selecteddealerstorename":"Selected Dealer Store Name",
        "customeraccountnumber":"Customer Account Number","selectedassetname":"Selected Asset Name",
        "selectedassetpartnumber":"Selected Asset Part Number","selectedassetserialnumber":"Selected Asset Serial Number",
        "devicemodel":"Device Model","operatingsystem":"Operating System",
        "operatingsystemversion":"Operating System Version","devicebuildnumber":"Device Build Number",
        "devicediskcapacitystorage":"Device Disk Capacity (Storage)","deviceorientation":"Device Orientation",
        "featureflags":"Feature Flags"
    };
    new URLSearchParams(window.location.search).forEach(function (v, k) {
        var key = map[k.toLowerCase()];
        if (key && key !== "Language" && v && v.trim()) sessionStorage.setItem(key, v.trim());
    });
})();
</script>

<!-- ===================== Language resolution + Contact preference + auto sign-in ===================== -->
<script>
(function () {
    "use strict";

    var DEFAULT_LCID = 1033;
    var ANON_KEY = "CAT_AnonLanguage";

    var isAuthenticated = {% if user %}true{% else %}false{% endif %};
    var contactId = "{{ user.id }}";
    var contactLcid = parseInt("{{ user.mspp_userpreferredlcid }}", 10) || null;

    var siteLanguages = [
        {% for language in page.languages %}"{{ language.code | escape }}"{% unless forloop.last %},{% endunless %}{% endfor %}
    ];
    window.CAT_SupportedLanguages = siteLanguages.slice();

    var config = [];
    try {
        config = JSON.parse(document.getElementById("catWebLanguagesConfig").textContent || "[]");
    } catch (e) {
        console.error("CAT_Web_Languages configuration is not valid JSON.", e);
    }

    /* ---------- helpers ---------- */
    function norm(code) {
        return String(code || "").trim().replace(/_/g, "-").toLowerCase();
    }
    function configByCode(code) {
        var c = norm(code);
        if (!c) return null;
        return config.find(function (x) { return norm(x.Code) === c; }) || null;
    }
    function configByLcid(lcid) {
        return config.find(function (x) { return Number(x.LocalID) === Number(lcid); }) || null;
    }
    function siteCodeByCode(code) {
        var c = norm(code);
        if (!c) return null;
        return siteLanguages.find(function (s) { return norm(s) === c; }) || null;
    }
    function resolve(cfg) {
        if (!cfg) return null;
        var site = siteCodeByCode(cfg.Code);
        return site ? { cfg: cfg, site: site } : null;
    }
    // Authenticated: config entry required (LocalID needed for Contact)
    // Anonymous: site language match only (no Dataverse access)
    function resolveCode(code) {
        if (isAuthenticated) return resolve(configByCode(code));
        var site = siteCodeByCode(code);
        return site ? { cfg: { Code: site, LocalID: null }, site: site } : null;
    }
    function pathLanguage() {
        var seg = window.location.pathname.split("/").filter(Boolean);
        return seg.length ? seg[0] : "";
    }
    function buildLanguageUrl(target) {
        var seg = window.location.pathname.split("/").filter(Boolean);
        var localized = siteLanguages.some(function (s) { return norm(s) === norm(seg[0]); });
        if (localized) seg[0] = target; else seg.unshift(target);
        var path = "/" + seg.join("/") + (window.location.pathname.endsWith("/") ? "/" : "");
        return path + window.location.search + window.location.hash;
    }

    /* ---------- Contact update via Power Pages Web API ---------- */
    function getToken() {
        return new Promise(function (ok, fail) {
            if (window.shell && typeof shell.getTokenDeferred === "function") {
                shell.getTokenDeferred().done(ok).fail(fail);
                return;
            }
            fetch("/_layout/tokenhtml")
                .then(function (r) { return r.text(); })
                .then(function (html) {
                    var m = html.match(/value="([^"]+)"/);
                    m ? ok(m[1]) : fail(new Error("Token not found"));
                })
                .catch(fail);
        });
    }

    function savePreferredLcid(lcid) {
        if (!isAuthenticated || !contactId || !lcid) return Promise.resolve();
        if (Number(lcid) === Number(contactLcid)) return Promise.resolve();

        return getToken().then(function (token) {
            return fetch("/_api/contacts(" + contactId + ")", {
                method: "PATCH",
                headers: {
                    "Content-Type": "application/json",
                    "Accept": "application/json",
                    "OData-MaxVersion": "4.0",
                    "OData-Version": "4.0",
                    "If-Match": "*",
                    "__RequestVerificationToken": token
                },
                body: JSON.stringify({ mspp_userpreferredlcid: Number(lcid) })
            });
        }).then(function (r) {
            if (r && !r.ok) throw new Error("Contact update failed: " + r.status);
            contactLcid = Number(lcid);
            console.log("Contact.mspp_userpreferredlcid updated to", lcid);
        }).catch(function (err) {
            console.error("Unable to save preferred language:", err);
        });
    }
    window.CAT_SavePreferredLcid = savePreferredLcid;
    window.CAT_ConfigByCode = configByCode;

    /* ---------- read URL ---------- */
    var urlLanguage = "", userState = "", product = "";
    new URLSearchParams(window.location.search).forEach(function (v, k) {
        var key = k.toLowerCase();
        if (key === "language") urlLanguage = v;
        if (key === "userstate") userState = v;
        if (key === "product") product = v;
    });

    /* ---------- priority: URL -> Contact -> English (browser language never used) ---------- */
    var target = null;
    var fromUrl = false;

    var urlResolved = resolveCode(urlLanguage);
    if (urlResolved) {
        target = urlResolved;
        fromUrl = true;
    } else {
        if (urlLanguage) console.warn("Invalid/unsupported URL language:", urlLanguage);

        if (isAuthenticated && contactLcid) {
            target = resolve(configByLcid(contactLcid));
        } else if (!isAuthenticated) {
            target = resolveCode(sessionStorage.getItem(ANON_KEY));
        }
    }
    if (!target) {
        target = isAuthenticated ? resolve(configByLcid(DEFAULT_LCID)) : resolveCode("en-us");
    }

    var savePromise = Promise.resolve();
    if (target && fromUrl) {
        if (isAuthenticated) savePromise = savePreferredLcid(target.cfg.LocalID);
        else sessionStorage.setItem(ANON_KEY, target.site);
    }

    savePromise.then(function () {
        if (target && norm(target.site) !== norm(pathLanguage())) {
            window.location.replace(buildLanguageUrl(target.site));
            return;
        }
        autoSignIn();
    });

    /* ---------- auto sign-in (userstate=loggedin) ---------- */
    function autoSignIn() {
        if (isAuthenticated) return;
        if (String(userState).trim().toLowerCase() !== "loggedin") return;

        var active = (target && target.site) || "en-US";
        var attemptKey = "pp_userstate_login_attempted_" + active.toLowerCase();
        if (sessionStorage.getItem(attemptKey) === "1") return;
        sessionStorage.setItem(attemptKey, "1");

        var provider = "https://signin.cat.com/cwslogin.onmicrosoft.com/oauth2/v2.0/authorize?p=b2c_1a_p2_v1_signin_nonprod";
        var rp = new URLSearchParams();
        if (product) rp.set("product", product);
        if (fromUrl) rp.set("language", target.cfg.Code); // URL language still wins after login

        var returnUrl = "/" + active + "/" + (rp.toString() ? "?" + rp.toString() : "");
        window.location.replace(
            "/" + active + "/Account/Login/ExternalLogin?returnUrl=" +
            encodeURIComponent(returnUrl) + "&provider=" + encodeURIComponent(provider)
        );
    }
})();
</script>
